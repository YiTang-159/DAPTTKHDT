rget="lab"><mxGeometry relative="1" x="0.13" y="-18" as="geometry" /></mxCell><mxCell id="m51" value="5.1: recordResult()" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.7;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;whiteSpace=wrap;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;" edge="1" parent="1" source="lab" target="result"><mxGeometry relative="1" x="0" y="-22" as="geometry" /></mxCell><mxCell id="note_a" parent="1" vertex="1" value="&lt;b&gt;Luồng chính:&lt;/b&gt; Bác sĩ bắt đầu lượt khám, tra cứu hồ sơ, ghi triệu chứng và chẩn đoán; kết quả được cập nhật vào hồ sơ bệnh án." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=13;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;fontFamily=Arial;fontSize=15;"><mxGeometry as="geometry" x="110" y="958" width="810" height="90" /></mxCell><mxCell id="note_b" parent="1" vertex="1" value="&lt;b&gt;Nhánh tùy chọn [cần xét nghiệm]:&lt;/b&gt; tạo chỉ định → kỹ thuật viên nhập kết quả → bác sĩ xem kết quả rồi hoàn tất chẩn đoán. Nếu không cần xét nghiệm thì bỏ qua bước 5." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=13;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;fontColor=#000000;fontFamily=Arial;fontSize=15;"><mxGeometry as="geometry" x="955" y="958" width="855" height="90" /></mxCell><mxCell id="footer" parent="1" vertex="1" value="Ghi chú: Mô hình thiết kế đề xuất, có thể điều chỉnh theo quy trình thực tế của phòng khám." style="text;html=1;whiteSpace=wrap;align=center;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=15;"><mxGeometry as="geometry" x="210" y="1082" width="1490" height="36" /></mxCell></root>
