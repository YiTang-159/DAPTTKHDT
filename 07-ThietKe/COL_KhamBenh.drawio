        <mxCell id="title" parent="1" vertex="1" value="SƠ ĐỒ CỘNG TÁC – KHÁM BỆNH VÀ XÉT NGHIỆM" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Arial;fontSize=27;fontStyle=1;"><mxGeometry as="geometry" x="365" y="55" width="1150" height="62" /></mxCell><mxCell id="subtitle" parent="1" vertex="1" value="Các thông điệp được đánh số theo thứ tự xử lý; nhánh xét nghiệm chỉ thực hiện khi có chỉ định." style="text;html=1;whiteSpace=wrap;align=center;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=15;"><mxGeometry as="geometry" x="365" y="125" width="1150" height="36" /></mxCell><mxCell id="d" parent="1" vertex="1" value=":Bác sĩ" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=16;strokeWidth=1.6;"><mxGeometry as="geometry" x="85" y="310" width="90" height="120" /></mxCell><mxCell id="ui" parent="1" vertex="1" value=":VisitUI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=17;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=7;"><mxGeometry as="geometry" x="320" y="335" width="210" height="72" /></mxCell><mxCell id="ctrl" parent="1" vertex="1" value=":VisitController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=17;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=7;"><mxGeometry as="geometry" x="658" y="335" width="240" height="72" /></mxCell><mxCell id="svc" parent="1" vertex="1" value=":VisitService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=17;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=7;"><mxGeometry as="geometry" x="1055" y="335" width="225" height="72" /></mxCell><mxCell id="medical" parent="1" vertex="1" v